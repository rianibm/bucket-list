{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM"], "module": "ESNext",
    "moduleResolution": "bundler", "strict": true, "skipLibCheck": true,
    "noEmit": true, "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  },
  "include": ["netlify/functions/**/*.mts", "netlify/lib/**/*.ts", "shared/**/*.ts", "db/**/*.ts", "drizzle.config.ts"]
}
